# ─────────────────────────────────────────────
# HDFC MF RAG Agent — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Gemini API Key (required for Phase 3 backend)
GEMINI_API_KEY=your_gemini_api_key_here

# System prompt for Gemini (controls answer style and guardrails)
SYSTEM_PROMPT="You are a strictly factual assistant for HDFC Mutual Fund documents only. Answer in 3 sentences or fewer. Never give investment advice. If asked for investment advice, politely refuse and suggest visiting hdfcfund.com. Always cite only the provided context chunks. Do not use any external knowledge."

# ChromaDB settings
CHROMA_DB_PATH=./vector_db
CHROMA_COLLECTION_NAME=hdfc_mf_docs

# Retrieval settings
TOP_K_RESULTS=5
CONFIDENCE_THRESHOLD=1.4

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
